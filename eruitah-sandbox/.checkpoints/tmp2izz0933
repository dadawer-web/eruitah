def test_save_and_load_game(game, player_configs):
    """测试保存和加载游戏进度"""
    state = game.create_new_game(player_configs)
    
    # 修改一些游戏状态
    game.get_player(0).money = 2000
    game.get_player(0).properties = [1, 3]
    game.get_player(1).money = 1000
    state.current_player_index = 1
    
    # 保存游戏
    game.save_game("test_save.json")
    
    # 创建新游戏实例并加载
    new_game = MonopolyGame()
    loaded_state = new_game.load_game("test_save.json")
    
    assert loaded_state.current_player_index == 1
    assert new_game.get_player(0).money == 2000
    assert new_game.get_player(0).properties == [1, 3]
    assert new_game.get_player(1).money == 1000
    
    # 清理测试文件
    if os.path.exists("test_save.json"):
        os.remove("test_save.json")