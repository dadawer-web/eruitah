#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
大富翁游戏单元测试
"""

import pytest
import os
import json
from monopoly_game import (
    MonopolyGame, CellType, EventType, GameCell, Player, GameState
)


@pytest.fixture
def game():
    """创建游戏实例的 fixture"""
    return MonopolyGame()


@pytest.fixture
def player_configs():
    """玩家配置 fixture"""
    return [
        {"name": "玩家1", "is_ai": False},
        {"name": "玩家2", "is_ai": True},
    ]


def test_create_new_game(game, player_configs):
    """测试创建新游戏"""
    state = game.create_new_game(player_configs)
    
    assert isinstance(state, GameState)
    assert len(state.players) == 2
    assert len(state.board) > 0
    assert state.current_player_index == 0
    assert not state.game_over
    assert state.winner is None
    
    # 检查玩家初始化
    for i, player in enumerate(state.players):
        assert player.id == i
        assert player.name == player_configs[i]["name"]
        assert player.is_ai == player_configs[i]["is_ai"]
        assert player.money == 1500  # 初始资金
        assert player.position == 0
        assert player.properties == []
        assert not player.in_jail
        assert player.jail_turns == 0
        assert not player.in_hospital
        assert player.hospital_turns == 0
        assert not player.extra_turn


def test_create_default_board(game):
    """测试创建默认地图"""
    board = game.create_default_board()
    
    assert len(board) == 15
    assert board[0].name == "起点"
    assert board[0].cell_type == CellType.START
    assert board[1].name == "北京路"
    assert board[1].cell_type == CellType.EMPTY
    assert board[1].price == 200
    assert board[1].base_rent == 20


def test_roll_dice(game):
    """测试掷骰子"""
    for _ in range(100):
        steps = game.roll_dice()
        assert 2 <= steps <= 12  # 两个六面骰子


def test_move_player(game, player_configs):
    """测试移动玩家"""
    state = game.create_new_game(player_configs)
    board_length = len(state.board)
    
    # 移动玩家0
    new_pos = game.move_player(0, 5)
    assert new_pos == 5
    assert game.get_player(0).position == 5
    
    # 测试环绕
    game.get_player(0).position = board_length - 2
    new_pos = game.move_player(0, 3)
    assert new_pos == 1  # (board_length - 2 + 3) % board_length = 1


def test_get_player(game, player_configs):
    """测试获取玩家"""
    state = game.create_new_game(player_configs)
    
    player0 = game.get_player(0)
    assert player0.id == 0
    assert player0.name == "玩家1"
    
    player1 = game.get_player(1)
    assert player1.id == 1
    assert player1.name == "玩家2"
    
    # 测试不存在的玩家
    with pytest.raises(ValueError):
        game.get_player(999)


def test_buy_property(game, player_configs):
    """测试购买房产"""
    state = game.create_new_game(player_configs)
    
    # 购买空地（北京路，ID=1）
    assert game.buy_property(0, 1) == True
    player0 = game.get_player(0)
    assert 1 in player0.properties
    assert player0.money == 1500 - 200  # 1500 - 200
    
    # 再次购买同一个房产应该失败
    assert game.buy_property(0, 1) == False
    
    # 其他玩家购买已拥有的房产应该失败
    assert game.buy_property(1, 1) == False
    
    # 购买非空地/房产格子应该失败
    assert game.buy_property(0, 0) == False  # 起点


def test_upgrade_property(game, player_configs):
    """测试升级房产"""
    state = game.create_new_game(player_configs)
    
    # 先购买房产
    assert game.buy_property(0, 1) == True
    
    # 升级房产
    assert game.upgrade_property(0, 1) == True
    player0 = game.get_player(0)
    assert player0.money == 1500 - 200 - 100  # 1500 - 购买费 - 升级费
    
    # 升级别人的房产应该失败
    assert game.upgrade_property(1, 1) == False
    
    # 升级不存在的房产应该失败
    assert game.upgrade_property(0, 999) == False


def test_process_lucky_event_reward(game, player_configs):
    """测试幸运事件 - 奖励"""
    state = game.create_new_game(player_configs)
    
    # 创建一个奖励事件格子
    reward_cell = GameCell(
        id=999, 
        name="测试奖励", 
        cell_type=CellType.LUCKY,
        event_data={"type": EventType.REWARD.value, "amount": 200}
    )
    
    player0 = game.get_player(0)
    initial_money = player0.money
    
    game.process_lucky_event(player0, reward_cell)
    
    assert player0.money == initial_money + 200


def test_process_lucky_event_extra_turn(game, player_configs):
    """测试幸运事件 - 额外回合"""
    state = game.create_new_game(player_configs)
    
    # 创建一个额外回合事件格子
    extra_turn_cell = GameCell(
