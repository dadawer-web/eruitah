def test_next_turn_normal(game, player_configs):
    """测试正常回合切换"""
    state = game.create_new_game(player_configs)
    
    assert state.current_player_index == 0
    
    # 正常切换到下一个玩家
    game.next_turn()
    assert state.current_player_index == 1
    
    # 再次切换回到第一个玩家
    game.next_turn()
    assert state.current_player_index == 0


def test_next_turn_extra_turn(game, player_configs):
    """测试额外回合"""
    state = game.create_new_game(player_configs)
    
    # 设置额外回合
    current_player = game.get_current_player()
    current_player.extra_turn = True
    
    # 应该保持当前玩家
    game.next_turn()
    assert state.current_player_index == 0
    assert not current_player.extra_turn  # 额外回合标志应被清除


def test_check_game_over(game, player_configs):
    """测试游戏结束检查"""
    state = game.create_new_game(player_configs)
    
    # 正常情况下游戏未结束
    game.check_game_over()
    assert not state.game_over
    assert state.winner is None
    
    # 让一个玩家破产
    game.get_player(1).money = -1
    
    game.check_game_over()
    assert state.game_over
    assert state.winner == 0  # 玩家0获胜


