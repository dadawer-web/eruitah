# ============================================================
# AI Service (Java Spring Boot) 本地运行环境变量
# 使用说明：复制本文件为 .env，然后填入真实值
#   cp .env.example .env
# ============================================================

# ============================================================
# 数据库配置
# ============================================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
REDIS_PASSWORD=your_redis_password_here
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================================
# 通义千问 / OpenAI 兼容 API（主要 AI 服务）
# ============================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com
OPENAI_MODEL=mimo-v2.5-pro

# ============================================================
# 备用模型配置（主模型限流时自动切换）
# ============================================================
FALLBACK_API_KEY=your_fallback_api_key_here
FALLBACK_BASE_URL=https://api.siliconflow.cn
FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct

# ============================================================
# 多模态 API（图像/视频理解）
# ============================================================
MULTIMODAL_API_KEY=your_multimodal_api_key_here
MULTIMODAL_BASE_URL=https://token-plan-cn.xiaomimimo.com
MULTIMODAL_MODEL=mimo-v2.5

# ============================================================
# 向量嵌入 API（RAG 检索增强）
# ============================================================
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=BAAI/bge-m3

# ============================================================
# 重排序 API（RAG 结果排序）
# ============================================================
RERANKER_API_KEY=your_reranker_api_key_here
RERANKER_BASE_URL=https://api.siliconflow.cn
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============================================================
# 搜索 API（联网搜索）
# ============================================================
SERPER_API_KEY=your_serper_api_key_here
SERPER_BASE_URL=https://google.serper.dev

# ============================================================
# 语音 API — 阿里 DashScope（ASR 识别 + 实时 TTS）
# ============================================================
ALI_ASR_API_KEY=your_ali_asr_api_key_here
ALI_ASR_MODEL=fun-asr-realtime-2026-02-28
ALI_REALTIME_TTS_MODEL=qwen3-tts-instruct-flash-realtime
ALI_REALTIME_TTS_VOICE=Cherry

# ============================================================
# 语音 API — 小米 MiMo（伴读 TTS 合成）
# ============================================================
XIAOMI_TTS_API_KEY=your_xiaomi_tts_api_key_here
XIAOMI_TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI_TTS_MODEL=mimo-v2.5-tts
XIAOMI_TTS_VOICE=冰糖

# ============================================================
# 语音文件存储
# ============================================================
VOICE_STORAGE_PATH=/tmp/audio
VOICE_URL_PREFIX=http://localhost/audio

# ============================================================
# Eruitah Sandbox Agent API（编程助手专用）
# ============================================================
ERUITAH_API_PROVIDER=openai
ERUITAH_SANDBOX_DIR=/tmp/eruitah-sandbox
ERUITAH_MODEL_OPENAI=mimo-v2.5-pro
ERUITAH_MODEL_ANTHROPIC=claude-sonnet-4-20250514
ERUITAH_ENABLE_VNC=false
ERUITAH_SCREEN_WIDTH=1280
ERUITAH_SCREEN_HEIGHT=720
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# Neo4j 连接（application.yml 中的 ${} 引用）
# ============================================================
# SPRING_NEO4J_URI=bolt://localhost:7687
# SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
# SPRING_NEO4J_AUTHENTICATION_PASSWORD=your_neo4j_password_here

# ============================================================
# Redis 连接（application.yml 中的 ${} 引用）
# ============================================================
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=your_redis_password_here

# ============================================================
# RPC 通信配置（application.yml 中的 ${} 引用）
# ============================================================
# RPC_CPP_HOST=127.0.0.1
# RPC_CPP_PORT=8888
# RPC_PYTHON_HOST=127.0.0.1
# RPC_PYTHON_PORT=9997
# RPC_INTERNAL_PORT=9999
