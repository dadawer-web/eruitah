# --- CMake 产生的垃圾 (无论在哪一层都会被忽略) ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake

# --- 编译产生的二进制文件 ---
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.a
*.lib

# --- 常见的构建目录名 ---
build/
bin/
lib/
# 你项目里特殊的拼写错误目录
bulid/ 

# --- IDE 配置文件 ---
.vscode/
.idea/
*.user
*.pro.user

# --- 日志和临时文件 ---
*.log
*.tmp

# === Qt Autogen 垃圾文件屏蔽 ===
*_autogen/
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
timestamp

# Maven/Gradle build output
target/
*.jar
*.war

# 忽略本地 Git 故障恢复备份文件
.gitbackup
.git_backup

# 环境变量文件（包含敏感信息）
.env