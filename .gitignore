CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake

# --- 编译产生的二进制文件 ---
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.a
*.lib

# --- 常见的构建目录名 ---
build/
bin/
lib/
# 你项目里特殊的拼写错误目录
bulid/ 

# --- IDE 配置文件 ---
.vscode/
.idea/
*.user
*.pro.user

# --- 日志和临时文件 ---
*.log
*.tmp
