/* 简化的Qt样式表 - 仅包含Qt支持的基本属性 */

/* 全局样式 */
QWidget {
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    font-size: 14px;
    color: #333;
    background-color: #f5f5f5;
}

/* 标题样式 */
QLabel[class="titleLabel"] {
    font-size: 24px;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 20px;
}

/* 登录窗口样式 */
QMainWindow[objectName="loginWindow"] {
    background-color: #f5f5f5;
}

/* 卡片样式 */
QWidget[class="card"] {
    background-color: white;
    border-radius: 12px;
    padding: 30px;
}

/* 输入框样式 */
QLineEdit {
    height: 40px;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 0 12px;
    font-size: 14px;
    background-color: white;
}

QLineEdit:focus {
    border-color: #3498db;
}

/* 按钮样式 */
QPushButton {
    height: 40px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    padding: 0 20px;
}

/* 主按钮 */
QPushButton[class="primaryButton"] {
    background-color: #3498db;
    color: white;
}

QPushButton[class="primaryButton"]:hover {
    background-color: #2980b9;
}

QPushButton[class="primaryButton"]:pressed {
    background-color: #2471a3;
}

/* 次要按钮 */
QPushButton[class="secondaryButton"] {
    background-color: #ecf0f1;
    color: #333;
    border: 1px solid #ddd;
}

QPushButton[class="secondaryButton"]:hover {
    background-color: #d5dbdb;
}

QPushButton[class="secondaryButton"]:pressed {
    background-color: #bdc3c7;
}

/* 聊天窗口样式 */
QMainWindow[objectName="chatWindow"] {
    background-color: #f5f5f5;
}

/* 联系人树样式 */
QTreeWidget {
    background-color: white;
    border: none;
    border-right: 1px solid #eee;
}

QTreeWidget::item {
    height: 40px;
    padding: 0 10px;
    border-radius: 6px;
    margin: 2px 8px;
}

QTreeWidget::item:hover {
    background-color: #f0f0f0;
}

QTreeWidget::item:selected {
    background-color: #e3f2fd;
    color: #1976d2;
}

QTreeWidget::header {
    background-color: #f5f5f5;
    border: none;
    border-bottom: 1px solid #eee;
    height: 30px;
}

/* 聊天标签页样式 */
QTabWidget::pane {
    background-color: white;
    border: none;
}

QTabBar::tab {
    background-color: #f5f5f5;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 20px;
    margin-right: 2px;
    border-radius: 8px 8px 0 0;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: white;
    border-bottom-color: #3498db;
    color: #3498db;
}

/* 聊天区域样式 */
QTextBrowser {
    background-color: #fafafa;
    border: none;
    padding: 10px;
    border-radius: 8px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    font-size: 14px;
}

/* 消息输入区域样式 */
QTextEdit {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 10px;
    background-color: white;
    font-size: 14px;
}

/* 分割器样式 */
QSplitter::handle {
    background-color: #eee;
    width: 1px;
}

/* 状态栏样式 */
QStatusBar {
    background-color: white;
    border-top: 1px solid #eee;
    color: #666;
    font-size: 12px;
}

/* 工具栏样式 */
QToolBar {
    background-color: white;
    border: none;
    border-bottom: 1px solid #eee;
}

/* 分割线样式 */
QFrame[class="separator"] {
    background-color: #eee;
    height: 1px;
    margin: 10px 0;
}

/* 滚动条样式 */
QScrollBar:vertical {
    width: 8px;
    background-color: #f5f5f5;
}

QScrollBar::handle:vertical {
    background-color: #bbb;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar:horizontal {
    height: 8px;
    background-color: #f5f5f5;
}

QScrollBar::handle:horizontal {
    background-color: #bbb;
    border-radius: 4px;
    min-width: 20px;
}

/* 主窗口样式 */
QMainWindow {
    background-color: #f5f5f5;
}

/* 中央窗口部件样式 */
QCentralWidget {
    background-color: #f5f5f5;
}

/* 停靠窗口样式 */
QDockWidget {
    background-color: #f5f5f5;
    color: #333;
    border: 1px solid #eee;
}

QDockWidget::title {
    background-color: #f5f5f5;
    color: #333;
    padding: 8px;
}

/* 菜单栏样式 */
QMenuBar {
    background-color: #f5f5f5;
    color: #333;
}

QMenuBar::item {
    background-color: #f5f5f5;
    color: #333;
    padding: 8px 12px;
}

QMenuBar::item:hover {
    background-color: #e0e0e0;
}

/* 菜单样式 */
QMenu {
    background-color: white;
    color: #333;
    border: 1px solid #ddd;
}

QMenu::item {
    background-color: white;
    color: #333;
    padding: 8px 20px;
}

QMenu::item:hover {
    background-color: #f0f0f0;
}