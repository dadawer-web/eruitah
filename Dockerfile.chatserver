FROM ubuntu:22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential cmake git \
    qtbase5-dev qtchooser qt5-qmake \
    libqt5svg5-dev \
    libmysqlclient-dev \
    libhiredis-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    protobuf-compiler libprotobuf-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/chenshuo/muduo.git /tmp/muduo && \
    cd /tmp/muduo && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    mkdir -p /usr/local/include/muduo_headers && \
    cp -r /tmp/muduo/include/* /usr/local/include/muduo_headers/ && \
    cp /tmp/muduo/build/lib-release/*.a /usr/local/lib/ 2>/dev/null || true

WORKDIR /app

COPY CMakeLists.txt .
COPY include/ include/
COPY src/ src/
COPY thirdparty/ thirdparty/

RUN sed -i 's|set(MUDUO_ROOT_DIR "/home/xmy/muduo")|set(MUDUO_ROOT_DIR "/usr/local")|g' src/server/CMakeLists.txt && \
    sed -i 's|include_directories(\${MUDUO_ROOT_DIR}/include)|include_directories(\${MUDUO_ROOT_DIR}/include/muduo_headers)|g' src/server/CMakeLists.txt && \
    sed -i 's|link_directories(\${MUDUO_ROOT_DIR}/build/lib)|link_directories(\${MUDUO_ROOT_DIR}/lib)|g' src/server/CMakeLists.txt && \
    mkdir build && cd build && \
    cmake .. && \
    make ChatServer -j$(nproc)

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    libmysqlclient21 \
    libhiredis0.14 \
    libssl3 \
    libcurl4 \
    libprotobuf23 \
    zlib1g \
    libqt5core5a \
    libqt5network5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build /app/build/bin/ChatServer .

EXPOSE 6000

ENTRYPOINT ["./ChatServer", "0.0.0.0", "6000"]
